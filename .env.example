# Reference only: the application does not automatically load .env files.
# Supply the real password/connection string through secret environment storage.
DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST:5432/postgres?sslmode=require
DATABASE_SCHEMA=gphem
DATABASE_POOL_SIZE=4
COOKIE_SECURE=1
ADMIN_USERNAME=YOUR_PRIVATE_USERNAME
ADMIN_PASSWORD=YOUR_PRIVATE_ADMIN_PASSWORD
TRUSTED_HOSTS=gphem.onrender.com
WEB_THREADS=2
# For explicit legacy/local SQLite use, leave DATABASE_URL unset and set:
# SEATING_DATABASE=/private/path/seating.sqlite
